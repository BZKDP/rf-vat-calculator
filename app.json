{
  "expo": {
    "name": "НДС Калькулятор РФ",
    "slug": "rf-vat-calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rfvatcalc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.evgeniishvydchenko.rfvatcalculator",
      "buildNumber": "2",
